# ==============================================================================
# OrgMind — Configuration Environment File
# ==============================================================================
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. To connect your existing FalkorDB Cloud instance:
#    Fill in the credentials from your FalkorDB Cloud console (https://app.falkordb.cloud).
#
# 3. If credentials are left blank or DEMO_MODE=true, OrgMind will run in
#    Zero-Config Demo Mode using an embedded realistic company graph (NovaTech Logistics).
# ==============================================================================

# FalkorDB Cloud Connection Settings
FALKORDB_HOST=your-falkordb-cloud-endpoint.falkordb.com
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=your_falkordb_password_here
FALKORDB_GRAPH=orgmind_demo

# Application Mode: set to false when connecting to FalkorDB Cloud
DEMO_MODE=true

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
